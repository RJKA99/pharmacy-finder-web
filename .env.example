# Server-only - never prefix with NEXT_PUBLIC_, it must not reach the client bundle.
# Primary routing/geocoding provider. Get a free key at https://account.heigit.org
ORS_API_KEY=

# Fallback provider, used only if ORS fails (see docs/adr/0003-routing-provider-fallback.md).
# Get a free key at https://www.graphhopper.com (free tier, non-commercial use).
GRAPHHOPPER_API_KEY=
